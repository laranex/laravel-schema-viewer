parameters:
    level: 7
    phpVersion: 80100
    paths:
        - src
        - config
        - scripts
    tmpDir: build/phpstan
    # One analysis process: Larastan boots the Testbench skeleton in every PHPStan worker, and each boot rewrites the
    # skeleton's bootstrap/cache/services.php and vendor link, which concurrent workers cannot share on Windows
    # (rename() and mklink fail while the other worker holds the file). The package itself writes nothing at boot.
    parallel:
        maximumNumberOfProcesses: 1
    configDirectories:
        - '%currentWorkingDirectory%/config'
    # Typed class constants need PHP 8.3; this package supports PHP 8.1.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: typeCoverage.constantTypeCoverage
        # Only some Laravel releases declare getRawListeners() on the events Dispatcher contract.
        - message: '#^Call to function method_exists\(\) with Illuminate\\Contracts\\Events\\Dispatcher and .getRawListeners. will always evaluate to true\.$#'
