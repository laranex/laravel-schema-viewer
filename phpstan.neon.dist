parameters:
    level: 7
    phpVersion: 80100
    paths:
        - src
        - config
    tmpDir: build/phpstan
    configDirectories:
        - '%currentWorkingDirectory%/config'
    # Typed class constants need PHP 8.3; this package supports PHP 8.1.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: typeCoverage.constantTypeCoverage
        # Only some Laravel releases declare getRawListeners() on the events Dispatcher contract.
        - message: '#^Call to function method_exists\(\) with Illuminate\\Contracts\\Events\\Dispatcher and .getRawListeners. will always evaluate to true\.$#'
